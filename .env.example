# Copy to your own environment; never commit live credentials.
APP_ENV=development
SEED_DEMO=1
COOKIE_SECURE=0
# Google Identity Services - Web Client ID from Google Cloud Console.
# Add http://localhost:8000 and http://127.0.0.1:8000 as authorized Javascript origins for local testing.
GOOGLE_CLIENT_ID=
# PostgreSQL recommended for staging/production after migrations are built.
# DATABASE_URL=postgresql+psycopg://user:password@host/database
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Email is queued in the database; run python mail_worker.py to deliver it.
PUBLIC_BASE_URL=http://127.0.0.1:8000
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_STARTTLS=1
SMTP_USER=
SMTP_PASSWORD=
MAIL_MESSAGE_DOMAIN=localhost
# Production PDF uploads fail closed without ClamAV.
CLAMAV_HOST=
CLAMAV_PORT=3310
# Optional private persistent storage path (never a public static directory).
PRIVATE_UPLOAD_DIR=
