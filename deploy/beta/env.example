# Copy to deploy/beta/.env on the server (setup-vm.sh does this for you). Never commit the real file.
BETA_DOMAIN=beta.ncore.space
# Shared beta login (Caddy basic auth). The hash is bcrypt; keep it in single quotes.
BETA_USER=sivrce
BETA_PASSWORD_HASH='replace-with-caddy-hash-password-output'
POSTGRES_PASSWORD=replace-with-a-long-random-value
# Password for the published demo accounts (company@demo.sivrce.ge etc.). Always override on the internet.
DEMO_PASSWORD=
# Moderator account created on first start (password at least 14 characters).
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional: Google sign-in (Web client ID; authorised origin https://beta.ncore.space)
GOOGLE_CLIENT_ID=
# Optional: e-mail delivery. Start the worker with: --profile mail
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# Optional: Cloud Storage bucket for nightly backups, e.g. gs://sivrce-beta-backups
BACKUP_BUCKET=
